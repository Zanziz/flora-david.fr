---
/*
 * Cadre commun à toutes les pages : <head> (titre, description, partage),
 * en-tête, contenu, pied de page.
 */
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { getEntry } from 'astro:content';
import Entete from '../components/Entete.astro';
import PiedDePage from '../components/PiedDePage.astro';
import { cheminPropre, getSite } from '../lib/contenu';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
	/** Titre de la page. Absent sur l'accueil. */
	titre?: string;
	/** Description pour Google. Par défaut, celle du site. */
	description?: string;
	/** Image d'aperçu lors d'un partage. Par défaut, la photo de l'accueil. */
	image?: ImageMetadata;
	/** Empêche l'indexation par les moteurs de recherche (page 404). */
	noindex?: boolean;
}

const { titre, description, image, noindex = false } = Astro.props;
const site = await getSite();
const accueil = await getEntry('accueil', 'accueil');

const titreComplet = titre ? `${titre} · ${site.nom}` : `${site.nom} · ${site.titre}`;
const descriptionPage = description ?? site.description;
const urlCanonique = new URL(cheminPropre(Astro.url), Astro.site);

const imagePartage = await getImage({
	src: image ?? accueil!.data.photo.src,
	width: 1200,
	height: 630,
	fit: 'cover',
	format: 'jpg',
});
const urlImagePartage = new URL(imagePartage.src, Astro.site);
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>
		<title>{titreComplet}</title>
		<meta name="description" content={descriptionPage} />
		{noindex && <meta name="robots" content="noindex" />}
		<link rel="canonical" href={urlCanonique} />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" href="/sitemap-index.xml" />

		<meta property="og:type" content="website" />
		<meta property="og:locale" content="fr_FR" />
		<meta property="og:site_name" content={site.nom} />
		<meta property="og:title" content={titreComplet} />
		<meta property="og:description" content={descriptionPage} />
		<meta property="og:url" content={urlCanonique} />
		<meta property="og:image" content={urlImagePartage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="generator" content={Astro.generator} />
	</head>
	<body>
		<a class="lien-evitement" href="#contenu">Aller au contenu</a>
		<Entete />
		<main id="contenu" tabindex="-1">
			<slot />
		</main>
		<PiedDePage />
	</body>
</html>
