---
import type { CollectionEntry } from 'astro:content';
import { Image, getImage } from 'astro:assets';

type Bloc = CollectionEntry<'projets'>['data']['galerie'][number];
interface Props { blocs: Bloc[]; projetId: string }

const { blocs, projetId } = Astro.props;
const galerieMarques = projetId === 'direction-artistique-ia';
const videos = import.meta.glob<string>('../content/projets/*/*.mp4', {
	eager: true, query: '?url', import: 'default',
});
function sourceVideo(nom: string) {
	const url = videos[`../content/projets/${projetId}/${nom}`];
	if (!url) throw new Error(`Vidéo introuvable dans ${projetId} : ${nom}`);
	return url;
}
const largeurs = (largeur: number) => [...[480, 800, 1200, 1600, 2000, 2400].filter((n) => n < largeur), largeur];

function tailles(bloc: Bloc) {
	if (galerieMarques) return '(min-width: 90rem) 21rem, (min-width: 48rem) 23vw, 46vw';
	switch (bloc.format) {
		case 'plein': return '(min-width: 90rem) 84rem, 94vw';
		case 'planches': return '(min-width: 60rem) 12rem, (min-width: 48rem) 20vw, 43vw';
		case 'quadriptyque': return '(min-width: 48rem) 23vw, 46vw';
		case 'collage': return '(min-width: 48rem) 31vw, 46vw';
		case 'triptyque': return '(min-width: 48rem) 31vw, 92vw';
		default: return bloc.proportion === 'capture' ? '(min-width: 48rem) 38vw, 92vw' : '46vw';
	}
}
---

<div class:list={['galerie', { 'galerie--marques': galerieMarques }]}>
	{blocs.map((bloc) => (
		<div class:list={['bloc', `bloc--${bloc.format}`, bloc.proportion && `bloc--${bloc.proportion}`]}>
			{bloc.titre && <h3 class="bloc__titre">{bloc.titre}</h3>}
			{bloc.images.length > 0 && (
				<div class:list={['bloc__images', {
					'bloc__images--films': bloc.format === 'collage' && bloc.images.length === 6 &&
						bloc.images.slice(0, 2).every((image) => image.video) && bloc.images.slice(2).every((image) => !image.video),
				}]}>
					{bloc.images.map(async (image, index) => (
						<figure style={{ '--proportion-source': image.src.width / image.src.height }}>
							{image.video ? (
								<video controls playsinline preload="none"
									aria-label={image.alt}
									poster={(await getImage({ src: image.src, width: image.src.width, format: 'webp' })).src}
									src={sourceVideo(image.video)} />
							) : <Image
								src={image.src} alt={image.alt}
								widths={largeurs(image.src.width)} sizes={tailles(bloc)}
								style={{ objectPosition: image.cadrage }}
								loading="lazy" decoding="async"
							/>}
							{bloc.reperes?.[index] && (
								<figcaption>
									<strong>{bloc.reperes[index].titre}</strong>
									<p>{bloc.reperes[index].texte}</p>
								</figcaption>
							)}
						</figure>
					))}
				</div>
			)}
			{bloc.legende && <p class="legende">{bloc.legende}</p>}
			{bloc.motsCles && (
				<ul class="mots-cles">{bloc.motsCles.map((mot) => <li>{mot}</li>)}</ul>
			)}
		</div>
	))}
</div>

<style>
	.galerie, .bloc { display: grid; }
	.galerie { gap: var(--espace-6); }
	.bloc { gap: var(--espace-3); align-items: start; }
	.bloc__titre { font-size: var(--texte-l); }
	.bloc__images {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--gouttiere);
	}
	.bloc figure { min-width: 0; }
	.bloc figure > :global(img), .bloc figure > video {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: var(--cadre, 4 / 5);
		object-fit: cover;
	}
	.bloc--plein .bloc__images,
	.bloc--capture .bloc__images, .bloc--newsletter .bloc__images { grid-template-columns: minmax(0, 1fr); }
	.bloc--plein figure > :global(img) { aspect-ratio: auto; }
	.bloc figure > video { background: var(--couleur-texte); }
	.bloc__images--films figure > video { aspect-ratio: 9 / 16; object-fit: contain; }
	.bloc figure > video:fullscreen { object-fit: contain; }
	.bloc--vertical { --cadre: 2 / 3; }
	.galerie--marques { gap: var(--espace-4); }
	.galerie--marques .bloc { --cadre: 4 / 5; }
	/* Une planche de références, en retrait par rapport aux grandes galeries. */
	.bloc--planches {
		--cadre: 3 / 2;
		width: min(100%, 58rem);
		margin-inline: auto;
		padding: var(--espace-4) var(--espace-3);
		gap: var(--espace-4);
	}
	.bloc--planches .bloc__images {
		align-items: start;
		gap: var(--espace-4) var(--espace-3);
	}
	.bloc--planches figcaption strong { display: block; font-size: var(--texte-s); line-height: 1.25; }
	.bloc--planches figcaption p { margin-top: var(--espace-1); font-size: .8125rem; line-height: 1.4; }

	.bloc--capture figure > :global(img), .bloc--newsletter figure > :global(img) {
		aspect-ratio: auto;
	}
	.bloc--capture .bloc__images { max-width: 66rem; margin-inline: auto; width: 100%; }

	.bloc figcaption { padding-top: var(--espace-2); max-width: var(--largeur-texte); }
	.bloc figcaption p, .legende { font-size: var(--texte-s); }
	.bloc figcaption p { color: var(--couleur-texte-doux); }
	.legende { max-width: var(--largeur-texte); }
	.bloc--triptyque:not(.bloc--newsletter) figure:first-child { grid-column: 1 / -1; }

	.bloc--texte .mots-cles li {
		display: block;
		padding: var(--espace-2) 0;
		border: 0;
		border-top: 1px solid var(--couleur-filet);
		border-radius: 0;
		text-align: left;
		line-height: 1.25;
	}
	.bloc--texte .mots-cles {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		width: min(100%, 32rem);
		gap: 0 var(--espace-4);
	}
	.bloc--texte { padding-block: var(--espace-4); }

	@media (min-width: 48rem) {
		.galerie--marques {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: var(--gouttiere);
			align-items: start;
		}
		.bloc--texte { grid-template-columns: 1fr 1fr; }

		.bloc--triptyque .bloc__images, .bloc--collage .bloc__images { grid-template-columns: repeat(3, minmax(0, 1fr)); }
		.bloc--triptyque:not(.bloc--newsletter) figure:first-child { grid-column: auto; }
		.bloc--quadriptyque .bloc__images { grid-template-columns: repeat(4, minmax(0, 1fr)); }
		.bloc--planches { padding: var(--espace-5) var(--espace-4); }
		.bloc--planches .bloc__images { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--espace-4); }
		.bloc--collage .bloc__images--films {
			grid-template-columns: minmax(0, 1.44fr) repeat(2, minmax(0, 1fr)) minmax(0, 1.44fr);
		}
		.bloc__images--films figure:has(video) { position: relative; grid-row: 1 / span 2; }
		.bloc__images--films figure:first-child { grid-column: 1; }
		.bloc__images--films figure:nth-child(2) { grid-column: 4; }
		.bloc__images--films figure > video { position: absolute; inset: 0; height: 100%; }
		/* Les captures restent lisibles en entier, avec la même hauteur de ligne. */
		.bloc--capture .bloc__images, .bloc--newsletter .bloc__images { display: flex; }
		.bloc--capture figure, .bloc--newsletter figure { flex: var(--proportion-source) 1 0%; }
	}
</style>
