---
/*
 * Encart « Mes derniers coups de cœur ».
 */
import { getCollection } from 'astro:content';

const elements = (await getCollection('coupsDeCoeur')).sort((a, b) => a.id.localeCompare(b.id));
---

{
	elements.length > 0 && (
		<aside class="coups" aria-labelledby="coups-titre">
			<h2 id="coups-titre" class="coups__titre">
				Mes derniers coups de cœur
			</h2>
			<ul class="coups__liste">
				{elements.map(({ data }) => (
					<li class="coups__element">
						<p class="surtitre">{data.categorie}</p>
						<p class="coups__oeuvre">
							{data.titre}
							{data.auteur && <span class="coups__auteur">, {data.auteur}</span>}
						</p>
						{data.phrase && <p class="coups__phrase">{data.phrase}</p>}
					</li>
				))}
			</ul>
		</aside>
	)
}

<style>
	.coups {
		padding-top: var(--espace-5);
		border-top: 1px solid var(--couleur-filet);
	}

	.coups__titre {
		font-size: var(--texte-l);
	}

	.coups__liste {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
		gap: var(--espace-5) var(--espace-4);
		margin-top: var(--espace-4);
		padding: 0;
		list-style: none;
	}

	.coups__element {
		display: grid;
		gap: var(--espace-1);
		align-content: start;
	}

	.coups__oeuvre {
		font-family: var(--police-titre);
		font-weight: var(--graisse-titre);
		font-size: var(--texte-l);
		line-height: 1.2;
	}

	.coups__auteur {
		font-family: var(--police-texte);
		font-weight: var(--graisse-texte);
		font-size: var(--texte-m);
	}

	.coups__phrase {
		font-size: var(--texte-s);
		color: var(--couleur-texte-doux);
	}
</style>
