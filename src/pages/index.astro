---
/*
 * Accueil : l'accroche, la photo principale, l'effet image trail,
 * puis le sommaire des thèmes.
 */
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import ImageTrail from '../components/ImageTrail.astro';
import Sommaire from '../components/Sommaire.astro';
import Base from '../layouts/Base.astro';
import { getSite, getThemes } from '../lib/contenu';

const site = await getSite();
const themes = await getThemes();
const accueil = (await getEntry('accueil', 'accueil'))!.data;
---

<Base>
	<section class="accueil" data-trail-zone>
		<div class="accueil__texte">
			<h1 class="accueil__accroche">{accueil.accroche}</h1>
			<p class="accueil__titre surtitre">{site.titre} · {site.ville}</p>
		</div>
		<Image
			class="accueil__photo"
			src={accueil.photo.src}
			alt={accueil.photo.alt}
			widths={[480, 720, 960, 1280, 1600]}
			sizes="(min-width: 64rem) 36vw, 92vw"
			loading="eager"
			fetchpriority="high"
		/>
		<ImageTrail images={accueil.trail} />
	</section>

	<div class="accueil__sommaire">
		<Sommaire themes={themes} />
	</div>
</Base>

<style>
	.accueil {
		position: relative;
		display: grid;
		gap: var(--espace-5);
		align-items: end;
		width: 100%;
		max-width: var(--largeur-max);
		margin-inline: auto;
		padding: var(--espace-6) var(--marge-page) var(--espace-6);
	}

	.accueil__texte {
		position: relative;
		z-index: 2;
		display: grid;
		gap: var(--espace-4);
	}

	.accueil__accroche {
		max-width: 14ch;
		font-size: var(--texte-xxl);
	}

	.accueil :global(.accueil__photo) {
		position: relative;
		z-index: 0;
		width: 100%;
		max-width: 32rem;
	}

	.accueil__sommaire {
		width: 100%;
		max-width: var(--largeur-max);
		margin-inline: auto;
		padding-inline: var(--marge-page);
	}

	@media (min-width: 64rem) {
		.accueil {
			grid-template-columns: 1fr minmax(0, 36%);
			min-height: min(85vh, 56rem);
		}

		.accueil :global(.accueil__photo) {
			justify-self: end;
		}
	}
</style>
